{
  // Wrangler configuration for deploying Gemini API Self-Hosted Environments
  // on Cloudflare Containers backed by Durable Objects.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gemini-api-self-hosted-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],

  // Each `environment_id` routes deterministically to its own stateful
  // `SelfHostedWorker` Durable Object instance via `env.SELF_HOSTED_WORKER.getByName(environmentId)`.
  "durable_objects": {
    "bindings": [
      {
        "name": "SELF_HOSTED_WORKER",
        "class_name": "SelfHostedWorker"
      }
    ]
  },

  // Build and bind the container image containing `/usr/local/bin/gemini-api`
  // and `/workspace` to the `SelfHostedWorker` Durable Object class.
  "containers": [
    {
      "class_name": "SelfHostedWorker",
      "scheduling_policy": "durable_object",
      "images": {
        "self_hosted": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],

  "exports": {
    "SelfHostedWorker": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
